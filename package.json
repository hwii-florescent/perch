{
  "name": "perch",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.0.1",
  "description": "Personal AI IDE / agent app",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @perch/shared && npm run build -w @perch/web",
    "test": "npm run test -w @perch/web",
    "build:mods-runtime": "node crates/perch-native/mods-runtime/react/build.mjs",
    "test:mods-runtime": "node --test crates/perch-native/mods-runtime/react/test/"
  },
  "devDependencies": {
    "react-reconciler": "^0.33.0",
    "typescript": "^5.6.3"
  }
}
