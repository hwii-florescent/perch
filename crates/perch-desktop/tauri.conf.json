{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "perch",
  "version": "0.0.1",
  "identifier": "dev.hwii.perch",
  "build": {
    "frontendDist": "../../packages/web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../packages/web/dist": "web-dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.15",
      "files": { "MacOS/perch": "../../target/release/perch" }
    },
    "linux": {
      "deb": { "files": { "/usr/bin/perch": "../../target/release/perch" } },
      "rpm": { "files": { "/usr/bin/perch": "../../target/release/perch" } },
      "appimage": { "files": { "usr/bin/perch": "../../target/release/perch" } }
    },
    "category": "DeveloperTool",
    "shortDescription": "Agent-babysitting IDE for Claude Code and Codex"
  }
}
